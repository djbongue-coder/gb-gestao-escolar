# ─────────────────────────────────────────────────────────────
# GB-GESTÃO ESCOLAR — Variáveis de ambiente
# Copiar para `.env` e preencher.  (cp .env.example .env)
# ─────────────────────────────────────────────────────────────

# OBRIGATÓRIO — Base de dados MySQL (drizzle/mysql2)
# Formato: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=

# OBRIGATÓRIO — Segredo para assinar o cookie de sessão (qualquer string longa)
JWT_SECRET=

# OBRIGATÓRIO — Login OAuth (Manus). Sem estes 3 o botão "Iniciar Sessão" não funciona.
# VITE_OAUTH_PORTAL_URL = portal de autenticação (ex.: https://forge.manus.ai)
# VITE_APP_ID            = id da app no Manus
# OAUTH_SERVER_URL       = usado pelo servidor para validar o token
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OAUTH_SERVER_URL=

# OBRIGATÓRIO — OpenId do utilizador dono (vira role=admin automaticamente)
OWNER_OPEN_ID=

# OPCIONAL — Apenas se usar as funções de IA
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─────────────────────────────────────────────────────────────
# Depois de preencher, criar as tabelas:
#   pnpm db:push
# ─────────────────────────────────────────────────────────────
